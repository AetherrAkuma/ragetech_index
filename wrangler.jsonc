{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ragetech-platform",
  "main": "worker.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ragetech_db",
      "database_id": "3663873e-3f82-4ce8-9e34-028e58400b35"
    }
  ]
}
