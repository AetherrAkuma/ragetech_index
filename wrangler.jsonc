{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ragetech-index",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ragetech_database",
      "database_id": "ac7535a2-d9a1-4932-851c-00a06135fac1"
    }
  ]
}
