{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ragetech-index",
  "main": "worker.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ragetech_db",
      "database_id": "29b104f8-6cf6-46e1-a7c7-7128f1378c15"
    }
  ]
}
