{
  "name": "ragetech-platform",
  "version": "2.0.0",
  "description": "Ragetech — Sovereign Systems Engineering Collective",
  "main": "worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "start": "npx serve -s . -l 3000",
    "db:migrate:local": "wrangler d1 execute ragetech_db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute ragetech_db --local --file=./seed.sql",
    "db:migrate:remote": "wrangler d1 execute ragetech_db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute ragetech_db --remote --file=./seed.sql",
    "deploy": "wrangler deploy"
  },
  "keywords": [
    "ragetech",
    "systems-engineering",
    "cloudflare-workers",
    "cloudflare-d1",
    "edge-computing"
  ],
  "author": "Ragetech Collective",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.109.2"
  }
}
